{
  "name": "yodo-mcp",
  "version": "1.5.0",
  "description": "MCP server for Yodo drawings",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sonaszjojka/yodo.git",
    "directory": "mcp"
  },
  "homepage": "https://github.com/sonaszjojka/yodo#use-yodo-from-ai-agents",
  "bugs": "https://github.com/sonaszjojka/yodo/issues",
  "keywords": [
    "mcp",
    "model-context-protocol",
    "yodo",
    "whiteboard",
    "diagram",
    "drawing"
  ],
  "type": "module",
  "bin": {
    "yodo-mcp": "dist/index.js"
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "vite build",
    "test": "vitest run",
    "test:server": "vitest run --config vitest.server.config.ts",
    "lint": "oxlint",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "smoke": "node scripts/smoke.ts",
    "prepack": "cp ../LICENSE LICENSE"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@napi-rs/canvas": "^1.1.0"
  },
  "devDependencies": {
    "@dagrejs/dagre": "^3.1.3",
    "@fontsource-variable/caveat": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@fontsource-variable/manrope": "^5.3.0",
    "@modelcontextprotocol/client": "^2.4.0",
    "@modelcontextprotocol/server": "^2.4.0",
    "@types/node": "^26.6.6",
    "oxlint": "^1.92.0",
    "prettier": "^3.9.10",
    "roughjs": "^4.6.6",
    "typescript": "~7.0.2",
    "vite": "^8.3.6",
    "vitest": "^5.1.0",
    "zod": "^4.6.7"
  }
}

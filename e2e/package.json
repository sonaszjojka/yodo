{
  "name": "e2e",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "build:app": "node scripts/build-app.ts",
    "test": "npm run build:app && playwright test",
    "lint": "oxlint",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "perf": "npm run build:app && playwright test -c playwright.perf.config.ts",
    "test:visual": "bash scripts/visual-docker.sh",
    "test:visual:update": "bash scripts/visual-docker.sh --update-snapshots"
  },
  "engines": {
    "node": ">=26"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/node": "^26.6.6",
    "oxlint": "^1.92.0",
    "prettier": "^3.9.10",
    "typescript": "~7.0.2"
  }
}

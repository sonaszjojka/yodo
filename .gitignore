# OS / editor
.DS_Store
.idea/
*.sw?
**/.vscode/*
!**/.vscode/extensions.json

# Secrets and local env
.env
.env.*
!.env.example

# Claude Code personal settings (shared settings.json stays tracked)
.claude/settings.local.json

# Node / web
node_modules/
dist/
*.local
coverage/
*.log

# Go / server
/server/bin/
*.test
*.out

# SQLite data from local runs
*.db
*.db-shm
*.db-wal

# Playwright
/e2e/test-results/
/e2e/playwright-report/

# Frontend copied in for go:embed by the image build (ADR 0019). Re-include
# the directory (the dist/ rule above ignores it) so its .gitkeep is tracked.
!/server/internal/webui/dist/
/server/internal/webui/dist/*
!/server/internal/webui/dist/.gitkeep

# E2E: the server binary built by `npm run build:app` (ADR 0035)
/e2e/.bin/
